{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest",
        "--browser=chrome",
        "--user-data-dir=.local/playwright-mcp/feishu"
      ],
      "cwd": ".",
      "enabled": true,
      "timeout": 30000
    }
  }
}
