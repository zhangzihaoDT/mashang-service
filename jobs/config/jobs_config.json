{
  "feature_jobs": {
    "daily_lock_count": {
      "module": "workspace",
      "label": "Daily Lock Count",
      "cwd": "{repo_root}",
      "argv_template": [
        "{python}",
        "workspace/business_scripts/daily_lock_count.py",
        "--date",
        "{date}",
        "--format",
        "json"
      ],
      "params": {
        "date": {
          "type": "date",
          "required": true
        }
      },
      "summary": "json",
      "timeout_seconds": 120
    },
