mashang_workspace/outputs/miit_new_car/evidence/
mashang_workspace/outputs/miit_new_car/state/

# MIIT EIDC 历史归档：原始附件二进制（.doc）不提交，仅本地保留证据
MIIT/data/eidc/*/attachments/
MIIT/data/eidc/*/raw_detail.html

# Auto launch: all outputs are runtime-generated, not committed
mashang_workspace/outputs/auto_launch/
auto_launch/outputs/

# Workspace report HTMLs: runtime-generated, not committed
mashang_workspace/outputs/reports/*.html

# CI eval output — regenerated on every make ci, not committed
mashang_workspace/outputs/tables/unified_eval_result.json

# Data dictionary — regenerated on every make data-dict, not committed
mashang_workspace/outputs/tables/data_dictionary.csv

# Defensive: promptbuilders should not contain runtime outputs
mashang_workspace/promptbuilders/outputs/

# Runtime reports: LS8 user profile snapshots
mashang_workspace/outputs/reports/ls8_user_profile_*.md
mashang_workspace/outputs/reports/ls8_user_profile_*.html

# Local MCP runtime
.playwright-mcp/

# Local chart scratch outputs
outputs/charts/
mashang_workspace/outputs/charts/

# Workspace outputs governance:
#   reports/*.md + tables/*.csv 为正式研究报告与研究证据表（Git tracked）
#   cache/debug/runtime 为可重建缓存与调试产物（不提交）
mashang_workspace/outputs/cache/
mashang_workspace/outputs/debug/
mashang_workspace/outputs/runtime/

# Smoke test runtime outputs (regenerated on every run)
outputs/smoke/

# OCR base capability: runtime cache (content-addressed, regenerable; historical evidence remains tracked)
outputs/ocr/

# Search base capability: local cache (regenerable, content-addressed)
outputs/search/

auto_launch/outputs/runs/

# auto_launch migration backup
auto_launch/outputs_backup_*
