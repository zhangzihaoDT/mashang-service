# Service-level browser ingestion download directory
dataset/incoming/feishu/

# Monthly market report runtime outputs (regenerated on every run)
mashang_workspace/outputs/monthly_market_report/

# MIIT runtime outputs — regenerated on every batch fetch, not committed
mashang_workspace/outputs/miit_new_car/raw/
mashang_workspace/outputs/miit_new_car/diagnostics/
mashang_workspace/outputs/miit_new_car/discovery/
mashang_workspace/outputs/miit_new_car/extracted/
mashang_workspace/outputs/miit_new_car/parsed/
