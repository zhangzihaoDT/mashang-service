{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "auto_launch_daily_monitor.schema.json",
  "title": "Auto Launch Daily Monitor Schema",
  "description": "Daily Sales Action Monitor 输出校验 schema。支持分层时间窗口、discovery_signals、search_audit。",
  "type": "object",
  "required": ["task_name", "battle_field", "our_model", "monitor_date", "time_window", "input_assets", "event_candidates", "no_event_models", "needs_review"],
  "properties": {
    "task_name": {"type": "string", "enum": ["auto_launch_daily_sales_action_monitor"]},
    "battle_field": {"type": "string"},
    "our_model": {"type": "string"},
    "monitor_date": {"type": "string"},
    "window_policy": {
      "type": "object",
      "properties": {
        "confirmed_event_window": {"type": "object"},
        "discovery_signal_window": {"type": "object"},
        "context_window": {"type": "object"}
      }
    },
    "time_window": {
      "type": "object",
      "properties": {
        "start": {"type": "string"},
        "end": {"type": "string"},
        "fallback_start": {"type": "string"}
      }
    },
    "input_assets": {"type": "object"},
    "event_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "event_model": {"type": "string"},
          "event_brand": {"type": "string"},
          "event_type": {"type": "string"},
          "event_name": {"type": "string"},
          "event_date": {"type": "string"},
          "confidence": {"type": "string", "enum": ["high", "medium", "low"]},
          "discovered_date": {"type": "string"},
          "source_publish_time": {"type": "string"},
          "window_match": {"type": "string"},
          "review_flags": {"type": "array", "items": {"type": "string"}},
          "source_items": {"type": "array"},
          "impact_vs_our_model": {
            "type": "object",
            "properties": {
              "price_pressure": {"type": "string", "enum": ["high", "medium", "low", "unknown"]},
              "rights_pressure": {"type": "string", "enum": ["high", "medium", "low", "unknown"]},
              "configuration_pressure": {"type": "string", "enum": ["high", "medium", "low", "unknown"]},
              "delivery_pressure": {"type": "string", "enum": ["high", "medium", "low", "unknown"]}
            }
          },
          "missing_evidence": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "discovery_signals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "event_model": {"type": "string"},
          "event_brand": {"type": "string"},
          "signal_type": {"type": "string"},
          "signal_name": {"type": "string"},
          "possible_event_type": {"type": "string"},
          "confidence": {"type": "string", "enum": ["low", "medium"]},
          "discovered_date": {"type": "string"},
          "source_publish_time": {"type": "string"},
          "window_match": {"type": "string"},
          "review_flags": {"type": "array", "items": {"type": "string"}},
          "source_items": {"type": "array"},
          "why_not_candidate": {"type": "string"},
          "missing_evidence": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "needs_review": {"type": "array", "items": {"type": "object"}},
    "no_event_models": {"type": "array", "items": {"type": "string"}},
    "search_audit": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "event_model": {"type": "string"},
          "event_brand": {"type": "string"},
          "searched_layers": {"type": "object"},
          "window_coverage": {"type": "object"},
          "source_coverage": {"type": "object"},
          "queries_used": {"type": "array", "items": {"type": "string"}},
          "coverage_note": {"type": "string"}
        }
      }
    }
  }
}
