{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "auto_launch_event.schema.json",
  "title": "Auto Launch Event Schema",
  "description": "结构化的竞品事件证据 JSON，由 AI 搜索输出后经 validate/normalize 生成。",
  "type": "object",
  "required": ["event_id", "event", "battle_field", "confirmed_facts", "inferences", "unconfirmed_claims", "confidence_level"],
  "properties": {
    "event_id": {
      "type": "string",
      "description": "事件唯一标识，格式：{brand}_{model}_{event_type}_{date}"
    },
    "event": {
      "type": "object",
      "description": "事件基本信息",
      "required": ["brand", "model", "event_type", "event_date"],
      "properties": {
        "brand": {"type": "string", "description": "事件品牌"},
        "model": {"type": "string", "description": "事件车型"},
        "event_type": {"type": "string", "description": "事件类型，如 launch / presale / delivery_start"},
        "event_date": {"type": "string", "description": "事件日期，ISO 格式 YYYY-MM-DD"},
        "event_date_confidence": {"type": "string", "enum": ["confirmed", "inferred", "unknown"]},
        "event_name": {"type": "string"},
        "location": {"type": "string"},
        "official_announcement_url": {"type": "string", "format": "uri"}
      }
    },
    "event_brand": {"type": "string", "description": "事件品牌（冗余字段，便于直接检索）"},
    "event_model": {"type": "string", "description": "事件车型（冗余字段，便于直接检索）"},
    "event_type": {"type": "string", "description": "事件类型（冗余字段，便于直接检索）"},
    "event_date": {"type": "string", "description": "事件日期 ISO 格式（冗余字段）"},
    "event_time_window": {
      "type": "object",
      "description": "事件关联的时间窗口",
      "properties": {
        "start": {"type": "string", "format": "date"},
        "end": {"type": "string", "format": "date"}
      }
    },
    "battle_field": {"type": "string", "description": "竞争战场，如 large_six_seat_suv"},
    "source_items": {
      "type": "array",
      "description": "所有来源项列表",
      "items": {
        "type": "object",
        "properties": {
          "tier": {"type": "integer", "enum": [1, 2, 3]},
          "name": {"type": "string"},
          "url": {"type": "string", "format": "uri"},
          "evidence": {"type": "string"}
        },
        "required": ["tier", "name", "url"]
      }
    },
    "confirmed_facts": {
      "type": "array",
      "description": "经官方或多源交叉验证确认的事实",
      "items": {"type": "string"}
    },
    "inferences": {
      "type": "array",
      "description": "基于已有信息的推断结论",
      "items": {"type": "string"}
    },
    "unconfirmed_claims": {
      "type": "array",
      "description": "未经验证的说法或传闻",
      "items": {"type": "string"}
    },
    "confidence_level": {
      "type": "string",
      "description": "整体置信度",
      "enum": ["high", "medium", "low", "unknown"]
    },
    "price_and_benefits": {
      "type": "object",
      "properties": {
        "msrp": {
          "type": "object",
          "properties": {
            "value": {"type": "string"},
            "confirmed": {"type": "boolean"},
            "source_url": {"type": "string", "format": "uri"}
          }
        },
        "deposit": {
          "type": "object",
          "properties": {
            "value": {"type": "string"},
            "confirmed": {"type": "boolean"},
            "source_url": {"type": "string", "format": "uri"}
          }
        },
        "limited_offer": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "item": {"type": "string"},
              "source_url": {"type": "string", "format": "uri"}
            }
          }
        },
        "finance_plan": {
          "type": "object",
          "properties": {
            "description": {"type": "string"},
            "source_url": {"type": "string", "format": "uri"}
          }
        }
      }
    },
    "product_positioning": {
      "type": "object",
      "properties": {
        "segment": {"type": "string"},
        "size": {"type": "string"},
        "range": {"type": "string"},
        "key_selling_points": {"type": "array", "items": {"type": "string"}},
        "autonomous_driving": {"type": "string"},
        "target_users": {"type": "string"}
      }
    },
    "competitive_landscape": {
      "type": "object",
      "properties": {
        "official_benchmark": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "competitor": {"type": "string"},
              "source_url": {"type": "string", "format": "uri"}
            }
          }
        },
        "media_comparison": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "summary": {"type": "string"},
              "source_url": {"type": "string", "format": "uri"}
            }
          }
        },
        "price_positioning": {"type": "string"},
        "differentiation": {"type": "array", "items": {"type": "string"}}
      }
    },
    "media_and_user_response": {
      "type": "object",
      "properties": {
        "media_reviews": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source": {"type": "string"},
              "conclusion": {"type": "string"},
              "source_url": {"type": "string", "format": "uri"}
            }
          }
        },
        "user_sentiment": {"type": "string"},
        "order_hotness": {"type": "string"}
      }
    },
    "evidence_quality": {
      "type": "object",
      "required": ["tier1_count", "tier2_count", "tier3_count", "unconfirmed_count"],
      "properties": {
        "tier1_count": {"type": "integer", "minimum": 0},
        "tier2_count": {"type": "integer", "minimum": 0},
        "tier3_count": {"type": "integer", "minimum": 0},
        "unconfirmed_count": {"type": "integer", "minimum": 0}
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "case_name": {"type": "string"},
        "prompt_version": {"type": "string"},
        "source_type": {"type": "string", "enum": ["chatgpt_plan", "manual", "volc_search"]},
        "normalized_at": {"type": "string", "format": "date-time"},
        "normalized_by": {"type": "string"}
      }
    }
  }
}
