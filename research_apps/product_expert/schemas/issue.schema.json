{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Product Expert Issue",
  "description": "Issue = 一个具体产品体验问题的归并单元。同一功能/体验维度、同一现象的多条 evidence 合并为一个 issue；跨门店出现只增加 store_count，不新建 issue。Issue 是 issue_review 门禁的评审对象。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "issue_id",
    "title",
    "category",
    "series",
    "description",
    "evidence_ids",
    "severity",
    "status",
    "business_signal"
  ],
  "properties": {
    "issue_id": {
      "type": "string",
      "pattern": "^ISS-[0-9]{4}$",
      "description": "问题唯一标识，如 ISS-0001"
    },
    "title": {
      "type": "string",
      "description": "一句话问题标题（对象 + 现象）"
    },
    "category": {
      "type": "string",
      "enum": [
        "exterior",
        "interior",
        "cockpit_ergonomics",
        "seating_space",
        "storage",
        "charging",
        "driving_dynamics",
        "nvh",
        "smart_cockpit",
        "adas",
        "quality_reliability",
        "configuration",
        "sales_service",
        "other"
      ],
      "description": "体验维度分类"
    },
    "series": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "enum": ["L6", "LS6", "LS7", "LS8", "LS9", "OTHER"] },
      "description": "涉及车系"
    },
    "affected_function": {
      "type": "string",
      "description": "具体功能/部件，如 前备箱开启 / 椭圆方向盘 / 冰箱口内沿"
    },
    "description": {
      "type": "string",
      "description": "问题描述：现象 + 影响，不含未证实的因果"
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^EV-[0-9]{4}$" },
      "description": "支撑本 issue 的 evidence，至少 1 条"
    },
    "evidence_count": {
      "type": "integer",
      "minimum": 1,
      "description": "支撑证据条数（通常 = evidence_ids 长度）"
    },
    "store_count": {
      "type": "integer",
      "minimum": 1,
      "description": "涉及门店数（去重后）"
    },
    "stores": {
      "type": "array",
      "items": { "type": "string" },
      "description": "涉及门店去重列表"
    },
    "severity": {
      "type": "string",
      "enum": ["blocker", "high", "medium", "low"],
      "description": "最终严重度：blocker=直接拒购/退单风险；high=高频或强不满影响决策；medium=明确不满非决定性；low=轻微/个别提及"
    },
    "severity_rationale": {
      "type": "string",
      "description": "严重度判定理由（引用证据或频次）"
    },
    "business_signal": {
      "type": "string",
      "enum": [
        "purchase_blocker",
        "complaint",
        "feature_request",
        "competitive_gap",
        "operational",
        "positive_signal",
        "other"
      ],
      "description": "业务信号类型：purchase_blocker=拒购风险；complaint=抱怨；feature_request=改进诉求；competitive_gap=对标差距；operational=门店运营；positive_signal=优势项"
    },
    "status": {
      "type": "string",
      "enum": ["candidate", "confirmed", "rejected", "duplicate", "merged"],
      "description": "评审状态机，见 workflow/issue_review.md"
    },
    "dup_of": {
      "type": "string",
      "pattern": "^ISS-[0-9]{4}$",
      "description": "status=duplicate/merged 时的目标 issue"
    },
    "rejection_reason": {
      "type": "string",
      "description": "status=rejected 时的拒绝理由"
    },
    "first_seen_date": {
      "type": "string",
      "description": "最早出现的支持日期原文"
    },
    "last_seen_date": {
      "type": "string",
      "description": "最近出现的支持日期原文"
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "description": "最近一次评审记录",
      "properties": {
        "reviewed_by": { "type": "string" },
        "reviewed_at": { "type": "string", "format": "date" },
        "decision": {
          "type": "string",
          "enum": ["confirmed", "rejected", "duplicate", "merged", "needs_evidence"]
        },
        "notes": { "type": "string" }
      }
    },
    "pattern_ids": {
      "type": "array",
      "items": { "type": "string", "pattern": "^PAT-[0-9]{4}$" },
      "description": "归入的 pattern（聚类后回填）"
    },
    "created_at": {
      "type": "string",
      "format": "date"
    }
  }
}
