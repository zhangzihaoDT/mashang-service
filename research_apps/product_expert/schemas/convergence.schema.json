{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Product Expert Convergence",
  "description": "Convergence = Pattern 的统计与来源派生快照。它是本研究所有数量、Attribution 与复现层级的唯一事实来源：全部字段由 pattern_key / pattern_id → issue_ids → evidence_ids → evidence.source_ref 确定性派生，不允许人工填写。Pattern 保持纯语义对象，Finding 只引用 Convergence，不复制统计。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "convergence_id",
    "pattern_id",
    "pattern_key",
    "run_id",
    "source_issue_ids",
    "source_evidence_ids",
    "attribution",
    "counts",
    "recurrence",
    "evidence_strength",
    "temporal_comparison"
  ],
  "properties": {
    "convergence_id": {
      "type": "string",
      "pattern": "^CONV-[0-9]{4}$",
      "description": "本次 run × pattern 的统计快照 ID，如 CONV-0001"
    },
    "pattern_id": {
      "type": "string",
      "pattern": "^PAT-[0-9]{4}$",
      "description": "本次 run 的 pattern 实例 ID"
    },
    "pattern_key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$",
      "description": "跨 run 的稳定语义主键，来自 patterns/pattern_keys.json 注册表"
    },
    "run_id": {
      "type": "string",
      "description": "所属 run，如 run_001"
    },
    "source_issue_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^ISS-[0-9]{4}$" },
      "description": "该 pattern 的 issue（来自 pattern.issue_ids）"
    },
    "source_evidence_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^EV-[0-9]{4}$" },
      "description": "由 source_issue_ids 展开并去重的 evidence"
    },
    "attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product_experts", "city_stores", "support_periods"],
      "description": "固定三维 provenance：全部从 evidence.source_ref 去重派生",
      "properties": {
        "product_experts": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "description": "产品专家（evidence.source_ref.expert）去重"
        },
        "city_stores": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "description": "支持城市+门店（evidence.source_ref.store）去重"
        },
        "support_periods": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["raw", "start_date", "end_date"],
            "properties": {
              "raw": { "type": "string", "description": "原文支持日期，如 9/10-13" },
              "start_date": { "type": "string", "description": "标准化开始日期 YYYY-MM-DD" },
              "end_date": { "type": "string", "description": "标准化结束日期 YYYY-MM-DD" }
            }
          },
          "description": "支持时间区间去重（按 start_date/end_date 键）"
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_count",
        "issue_count",
        "product_expert_count",
        "city_store_count",
        "support_period_count",
        "series_count"
      ],
      "description": "全部计数由数组长度派生，不手工填写",
      "properties": {
        "evidence_count": { "type": "integer", "minimum": 1 },
        "issue_count": { "type": "integer", "minimum": 1 },
        "product_expert_count": { "type": "integer", "minimum": 1 },
        "city_store_count": { "type": "integer", "minimum": 1 },
        "support_period_count": { "type": "integer", "minimum": 1 },
        "series_count": { "type": "integer", "minimum": 1 }
      }
    },
    "cross_store": {
      "type": "boolean",
      "description": "派生：city_store_count ≥ 2"
    },
    "cross_series": {
      "type": "boolean",
      "description": "派生：series_count ≥ 2"
    },
    "recurrence": {
      "type": "string",
      "enum": ["isolated", "repeated", "systemic"],
      "description": "由 city_store_count / series_count / support_period_count 按 convergence.md 规则派生"
    },
    "evidence_strength": {
      "type": "string",
      "enum": ["weak", "moderate", "strong"],
      "description": "由 recurrence 映射：isolated→weak；repeated→moderate；systemic→strong"
    },
    "temporal_comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "description": "跨 Convergence 的时间比较；首个 wave 为 baseline_only",
      "properties": {
        "status": { "type": "string", "enum": ["baseline_only", "compared"] },
        "baseline_run_id": { "type": "string" },
        "compared_run_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "delta": {
          "type": "object",
          "description": "跨 run 变化：counts / attribution / recurrence 的增减，不做因果解释"
        },
        "notes": { "type": "string" }
      }
    },
    "derived_at": {
      "type": "string",
      "format": "date",
      "description": "派生日期 YYYY-MM-DD"
    }
  }
}
