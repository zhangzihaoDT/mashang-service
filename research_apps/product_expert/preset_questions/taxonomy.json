{
  "taxonomy_version": "0.1",
  "description": "预设问题 taxonomy（Preset Question Coding）。这些问题在抽取前已经定义，LLM 只做编码器：把自由文本映射到固定 code；计数由 derive_preset_stats.py 确定性聚合。与 Open Discovery（Evidence → Issue → Pattern → Convergence）是两种不同的研究方法，结果不得互相替代或合并。",
  "models": ["L6", "LS6", "LS8", "LS9", "STORE", "OTHER"],
  "model_notes": {
    "STORE": "全店 / 未区分车型：原文只到门店层级，未指向具体车型（如门店客流、无试驾车）。",
    "OTHER": "其他具体车型（非 L6/LS6/LS8/LS9）。"
  },
  "groups": {
    "support_overview": {
      "label": "门店支持概况",
      "mode": "direct_field",
      "note": "由记录直接字段统计，不需要 LLM 编码。",
      "fields": ["产品专家", "支持城市+门店", "支持日期"]
    },
    "store_ops": {
      "label": "门店经营现场",
      "mode": "coded_from_text",
      "source_field": "store_sales",
      "note": "只统计门店经营字段中明确写出的内容；未写出即未记录。",
      "codes": {
